PROJECT_NAME="Support AI RAG Platform"
DEBUG=True
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# PostgreSQL (хранилище реляционных данных)
DB_HOST=localhost
DB_PORT=5432
DB_USER=rag_user
DB_PASS=rag_password
DB_NAME=rag_db
DB_ECHO=False

# Redis (брокер задач Taskiq, кэш, очереди операторов)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CHAT_CONTEXT_TTL_SECONDS=1800
CHAT_CONTEXT_MAX_MESSAGES=10

# Qdrant (векторная база данных)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=knowledge_base

# CORS (разрешенные источники фронтенда)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# JWT и безопасность
JWT_SECRET_KEY=super-secret-jwt-key-for-dev-environment-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Хранилище исходных и обработанных файлов базы знаний
KB_STORAGE_DIR=storage/kb_documents
