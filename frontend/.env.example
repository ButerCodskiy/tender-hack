# Флаг режима работы фронтенда:
# - VITE_STANDALONE=true  : Автономный режим («чисто визуал»). Работает полностью без API и БД.
# - VITE_STANDALONE=false : Подключение к реальному бэкенду (FastAPI, Postgres, Redis, Qdrant).
VITE_STANDALONE=false

# Адрес бэкенда для проксирования запросов
VITE_BACKEND_URL=http://127.0.0.1:8000
